# ---------------------------------------------------------------------------
# LiveKit (required) — voice transport + Inference (STT/LLM/TTS by default)
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Moss (required) — semantic search / per-user memory (https://docs.moss.dev)
# ---------------------------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_MODEL_ID=moss-minilm

# ---------------------------------------------------------------------------
# Unsiloed (ingest) — parses the tax PDF into chunks (src/ingest_tax.py)
# ---------------------------------------------------------------------------
UNSILOED_API_KEY=

# ---------------------------------------------------------------------------
# Voice (TTS) — MiniMax is the default sponsor voice.
#   TTS_PROVIDER: "minimax" (default) | "cartesia"
#   MiniMax needs an INTERNATIONAL account; the agent targets api.minimaxi.chat.
#   Auto-falls back to Cartesia if MINIMAX_API_KEY/MINIMAX_GROUP_ID are unset.
# ---------------------------------------------------------------------------
TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# MINIMAX_TTS_MODEL=speech-02-turbo
# MINIMAX_TTS_VOICE=presenter_female
# MINIMAX_BASE_URL=https://api.minimaxi.chat/v1/t2a_v2   # override only if needed

# ---------------------------------------------------------------------------
# LLM — default is LiveKit Inference (no separate key). To govern the LLM via
# TrueFoundry (or route to Qwen/DashScope), set LLM_BASE_URL and the agent
# routes through that OpenAI-compatible gateway. PII/PHI redaction is applied
# at the gateway via the TRUEFOUNDRY_GUARDRAILS header (input AND output).
# ---------------------------------------------------------------------------
# LLM_MODEL=openai/gpt-5.2-chat-latest           # gateway id e.g. openai-main/gpt-4o-mini
# LLM_PROVIDER=                                   # Inference provider override (e.g. cerebras)
# LLM_BASE_URL=https://gateway.truefoundry.ai     # set -> route through the gateway
# LLM_API_KEY=                                    # TrueFoundry PAT/VAT (or DashScope key)
# TRUEFOUNDRY_GUARDRAILS={"llm_input_guardrails":["<group>/pii"],"llm_output_guardrails":["<group>/pii"]}
# TRUEFOUNDRY_METADATA={"app":"ai-cpa","feature":"voice"}
# TRUEFOUNDRY_TTFT_TIMEOUT_MS=1500
#
# Qwen direct (Alibaba DashScope) — simplest Qwen path: just set QWEN_API_KEY.
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus                              # or qwen-max / qwen-turbo
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # intl; China: drop "-intl"

# ---------------------------------------------------------------------------
# Avatar (optional talking head) — off by default (voice-only). Controlled
# entirely here: set AVATAR_PROVIDER to turn it on, or =none / comment it out to
# run voice-only and save avatar credits during testing.
#   AVATAR_PROVIDER=simli (recommended; generous free tier) or =tavus.
#   Degrades to voice-only automatically if creds are missing.
# ---------------------------------------------------------------------------
# AVATAR_PROVIDER=simli
# SIMLI_API_KEY=
# SIMLI_FACE_ID=
# SIMLI_EMOTION_ID=
#
# Tavus alternative (higher realism, ~25 free min/account). Create a persona
# with pipeline_mode=echo + a livekit transport layer, then set the ids:
# AVATAR_PROVIDER=tavus
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=
# TAVUS_PERSONA_ID=
