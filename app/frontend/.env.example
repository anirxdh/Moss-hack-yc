# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch.
# Moss dispatches explicitly to the Python agent registered as `agent-py`.
AGENT_NAME=agent-py

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# --- Clerk auth (set automatically by `clerk init`; values in .env.local) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# --- Document upload to S3 + ingest trigger ---
# AWS creds resolve from this named profile for local dev (no static keys needed).
AWS_PROFILE=moss-hackathon
AWS_REGION=us-west-2
S3_UPLOAD_BUCKET=moss-yc-hackathon-docs
# Where the agent-py FastAPI ingest service is reachable.
AGENT_INGEST_URL=http://localhost:8000
# Shared secret guarding POST /ingest — MUST match agent-py/.env.local.
AGENT_INGEST_SECRET=
